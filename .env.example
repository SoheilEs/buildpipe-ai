NODE_ENV=production
PORT=3000
AI_ENGINE_PORT=3001
API_INTERNAL_URL=http://api:3000

# PostgreSQL. Docker Compose builds its own DATABASE_URL from POSTGRES_* below.
# DATABASE_URL is only used when you run the API or worker outside Compose (local development).
POSTGRES_USER=infralark
POSTGRES_DB=infralark
# Required by Compose, no default. Generate with:  openssl rand -hex 24  (hex keeps the URL safe)
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://infralark:CHANGE_ME@localhost:5432/infralark?schema=public

REDIS_HOST=redis
REDIS_PORT=6379

NATS_URL=nats://nats:4222

# Secrets: the API refuses to start while any of these is missing, shorter than 32 characters,
# still a CHANGE_ME placeholder, or a value that was ever published in this repository.
# Generate each one separately with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=CHANGE_ME

# First admin account, created by the seed script on start. There is no default admin.
# Password: 12+ characters, not a placeholder. Leave both empty to seed nobody.
ADMIN_EMAIL=
ADMIN_PASSWORD=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai

OTP_EMAIL_FROM=noreply@buildpipe.ai
# Local development only: returns the OTP in the API response and logs it. There is no real
# delivery channel yet, so OTP-gated actions need this set to true to be usable. Never in production.
OTP_DEV_MODE=false
# Allowed browser origins, comma separated, e.g. https://app.example.com
# Empty = no cross-origin access. "*" is rejected when NODE_ENV=production.
CORS_ORIGIN=
