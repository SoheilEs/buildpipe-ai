NODE_ENV=production
PORT=3000
AI_ENGINE_PORT=3001
API_INTERNAL_URL=http://api:3000

DATABASE_URL=file:/app/data/buildpipe.db

REDIS_HOST=redis
REDIS_PORT=6379

NATS_URL=nats://nats:4222

JWT_SECRET=buildpipe-docker-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=buildpipe-docker-refresh-secret-32c
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=buildpipe-docker-encryption-key-32b==

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai

OTP_EMAIL_FROM=noreply@buildpipe.ai
# Local development only: returns the OTP in the API response and logs it. There is no real
# delivery channel yet, so OTP-gated actions need this set to true to be usable. Never in production.
OTP_DEV_MODE=false
CORS_ORIGIN=*