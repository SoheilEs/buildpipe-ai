generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  viewer
  operator
  admin
}

enum AuthProvider {
  local
  github
  google
}

enum IncidentStatus {
  CREATED
  ENRICHING
  ANALYZING
  ANALYZED
  RESOLVED
}

enum RiskLevel {
  low
  medium
  high
}

// Request lifecycle (ADR-0001). The names must match apps/api/src/service-requests/domain.
enum ServiceRequestStatus {
  Requested
  Collecting
  NeedsReview
  ProposalReady
  AwaitingApproval
  Approved
  Testing
  Verified
  Failed
  Rejected
  Cancelled
}

enum OtpPurpose {
  cluster_register
  cluster_update
  deployment_restart
  mcp_sensitive
  login_verification
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?
  role         UserRole     @default(viewer)
  provider     AuthProvider @default(local)
  providerId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  refreshTokens   RefreshToken[]
  otpChallenges   OtpChallenge[]
  incidents       Incident[]       @relation("IncidentCreator")
  auditLogs       AuditLog[]
  serviceRequests ServiceRequest[] @relation("ServiceRequestRequester")

  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OtpChallenge {
  id         String     @id @default(uuid())
  userId     String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Cluster {
  id                  String    @id @default(uuid())
  name                String
  encryptedKubeconfig String
  context             String?
  lastConnectedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  incidents Incident[]

  @@index([name])
  @@index([deletedAt])
}

model Incident {
  id           String         @id @default(uuid())
  clusterId    String
  title        String
  description  String?
  status       IncidentStatus @default(CREATED)
  resourceType String?
  resourceName String?
  namespace    String?
  signature    String?
  createdById  String
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  cluster   Cluster      @relation(fields: [clusterId], references: [id])
  createdBy User         @relation("IncidentCreator", fields: [createdById], references: [id])
  analyses  AiAnalysis[]

  @@index([status, clusterId])
  @@index([signature])
  @@index([deletedAt])
}

model AiAnalysis {
  id              String    @id @default(uuid())
  incidentId      String
  provider        String
  model           String
  rootCause       String
  confidence      Float
  evidence        String
  recommendations String
  riskLevel       RiskLevel
  rawPromptHash   String?
  createdAt       DateTime  @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentPattern {
  id            String   @id @default(uuid())
  signature     String   @unique
  rootCause     String
  frequency     Int      @default(1)
  avgConfidence Float    @default(0)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([signature])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
}

model FailedJob {
  id        String   @id @default(uuid())
  queueName String
  jobName   String
  jobId     String
  payload   String
  error     String
  attempts  Int
  failedAt  DateTime @default(now())

  @@index([queueName, failedAt])
}

model ServiceRequest {
  id             String               @id @default(uuid())
  // Service card id, e.g. "nonroot-runtime-review". The services registry arrives in Phase 2.2.
  kind           String
  status         ServiceRequestStatus @default(Requested)
  requesterId    String
  // Same key from the same requester returns the same request. NULLs never collide.
  idempotencyKey String?
  // Optimistic lock: every transition increments it and only applies to the version it read.
  version        Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  requester   User                       @relation("ServiceRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  transitions ServiceRequestTransition[]

  @@unique([requesterId, idempotencyKey])
  @@index([status])
  @@index([requesterId])
}

// Append-only history. The application only ever inserts; rows are never updated or deleted.
model ServiceRequestTransition {
  id         String                @id @default(uuid())
  // Strict insertion order. createdAt can tie within a millisecond; seq cannot.
  seq        Int                   @default(autoincrement())
  requestId  String
  // Null only for the creation row.
  fromStatus ServiceRequestStatus?
  toStatus   ServiceRequestStatus
  // A user id, or "system" for the worker. Not a foreign key on purpose.
  actorId    String
  reason     String?
  createdAt  DateTime              @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, seq])
}
